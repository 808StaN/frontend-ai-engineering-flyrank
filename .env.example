# Public API used by the /health page (no secrets required)
HEALTH_CHECK_API_URL=https://jsonplaceholder.typicode.com/posts/1

# Server-only OpenRouter key for the /chat streaming route.
# Create a key at https://openrouter.ai/keys. Never prefix this with NEXT_PUBLIC_.
OPENROUTER_API_KEY=

# Server-only Upstash REST credentials for distributed /api/chat rate limiting.
# Create a Redis database at https://console.upstash.com/ and never commit these values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
